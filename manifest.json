{
  "manifest_version": 1,
  "id": "io.dbx.rocketmq-dashboard-console",
  "name": "dbx-rocketmq-dashboard",
  "version": "0.3.0",
  "publisher": "ezreal-byte",
  "description": "一个类似于 apache/rocketmq-dashboard 的 RocketMQ 驾驶舱，复刻其 UI 与业务交互，通过 Go 后端在 DBX 中管理集群、Topic、Group、消息和 ACL。",
  "icon": "assets/rocketmq.svg",
  "permissions": [
    "host.workbench"
  ],
  "engines": {
    "dbx": ">=0.6.17",
    "host_api": "1"
  },
  "entrypoints": {
    "backend": {
      "protocol_versions": [
        1
      ],
      "transport": "stdio-jsonl",
      "executable": "bin/dbx-rocketmq-dashboard"
    },
    "ui": {
      "root": "ui",
      "entry": "ui/index.html"
    }
  },
  "contributions": [
    {
      "type": "connection-provider",
      "id": "io.dbx.rocketmq-dashboard-console.connection",
      "label": "RocketMQ 连接",
      "icon": "assets/rocketmq.svg",
      "database_type": "rocketmq-dashboard-dbx-plugin",
      "description": "连接 Apache RocketMQ NameServer，管理 Topic、消费组、消息与 ACL 权限。",
      "proxy_route": true,
      "fields": [
        {
          "key": "display_name",
          "label": "连接名称",
          "type": "text",
          "binding": "name",
          "default": "RocketMQ"
        },
        {
          "key": "host",
          "label": "IP / 域名",
          "type": "text",
          "binding": "host",
          "required": true,
          "default": "127.0.0.1"
        },
        {
          "key": "port",
          "label": "端口",
          "type": "number",
          "binding": "port",
          "required": true,
          "default": 9876
        },
        {
          "key": "namesrv_addr",
          "label": "NameServer 地址",
          "type": "text",
          "binding": "config",
          "description": "留空则使用上方 IP 与端口；多地址用分号分隔"
        },
        {
          "key": "cluster_name",
          "label": "集群名",
          "type": "text",
          "binding": "config",
          "description": "留空则自动探测"
        },
        {
          "key": "access_key",
          "label": "AccessKey",
          "type": "password",
          "binding": "secret",
          "description": "启用 ACL 认证时填写"
        },
        {
          "key": "secret_key",
          "label": "SecretKey",
          "type": "password",
          "binding": "secret"
        },
        {
          "key": "use_tls",
          "label": "启用 TLS",
          "type": "boolean",
          "binding": "config",
          "default": false
        },
        {
          "key": "vip_channel",
          "label": "VIP Channel",
          "type": "boolean",
          "binding": "config",
          "default": false,
          "description": "使用 Broker 管理端口减 2 的 VIP 通道"
        },
        {
          "key": "proxy_addr",
          "label": "RocketMQ Proxy 地址",
          "type": "text",
          "binding": "config",
          "description": "可选 Remoting 地址（不是 gRPC 端口）；多地址以分号分隔"
        },
        {
          "key": "tls_skip_verify",
          "label": "跳过 TLS 证书校验",
          "type": "boolean",
          "binding": "config",
          "default": false
        },
        {
          "key": "read_only",
          "label": "只读模式",
          "type": "boolean",
          "binding": "config",
          "default": false,
          "description": "禁止所有写操作（创建/删除/修改/发送消息）"
        },
        {
          "key": "page_size",
          "label": "每页数量",
          "type": "number",
          "binding": "config",
          "default": 50
        }
      ],
      "workbench": "io.dbx.rocketmq-dashboard-console.workbench",
      "capabilities": [
        "test",
        "connect",
        "disconnect"
      ]
    },
    {
      "type": "workbench",
      "id": "io.dbx.rocketmq-dashboard-console.workbench",
      "label": "RocketMQ 控制台",
      "icon": "assets/rocketmq.svg"
    }
  ],
  "localizations": {
    "en": {
      "name": "RocketMQ Console",
      "description": "Apache RocketMQ 4.x/5.x cluster console: brokers, topics, consumer groups, producers and consumers, message query, message trace and ACL permissions",
      "contributions": {
        "io.dbx.rocketmq-dashboard-console.connection": {
          "label": "RocketMQ connection",
          "description": "Connect to an Apache RocketMQ NameServer to manage topics, consumer groups, messages and ACL permissions.",
          "fields": {
            "display_name": {
              "label": "Connection name"
            },
            "host": {
              "label": "Host / domain"
            },
            "port": {
              "label": "Port"
            },
            "namesrv_addr": {
              "label": "NameServer addresses",
              "description": "Leave empty to use the host and port above; separate multiple addresses with semicolons"
            },
            "cluster_name": {
              "label": "Cluster name",
              "description": "Leave empty to detect automatically"
            },
            "access_key": {
              "label": "AccessKey",
              "description": "Required when ACL authentication is enabled"
            },
            "secret_key": {
              "label": "SecretKey"
            },
            "tls_skip_verify": {
              "label": "Skip TLS certificate verification"
            },
            "read_only": {
              "label": "Read only",
              "description": "Rejects every write operation (create, delete, update, send message)"
            },
            "page_size": {
              "label": "Page size"
            }
          }
        },
        "io.dbx.rocketmq-dashboard-console.workbench": {
          "label": "RocketMQ console"
        }
      }
    },
    "zh-TW": {
      "name": "RocketMQ 控制台",
      "description": "Apache RocketMQ 4.x/5.x 叢集管理控制台：Broker、Topic、消費組、生產者消費者、訊息查詢、訊息軌跡與 ACL 權限",
      "contributions": {
        "io.dbx.rocketmq-dashboard-console.connection": {
          "label": "RocketMQ 連線",
          "description": "連線 Apache RocketMQ NameServer，管理 Topic、消費組、訊息與 ACL 權限。",
          "fields": {
            "display_name": {
              "label": "連線名稱"
            },
            "host": {
              "label": "IP / 網域"
            },
            "port": {
              "label": "連接埠"
            },
            "namesrv_addr": {
              "label": "NameServer 位址",
              "description": "留空則使用上方 IP 與連接埠；多個位址以分號分隔"
            },
            "cluster_name": {
              "label": "叢集名稱",
              "description": "留空則自動探測"
            },
            "access_key": {
              "label": "AccessKey",
              "description": "啟用 ACL 認證時填寫"
            },
            "secret_key": {
              "label": "SecretKey"
            },
            "tls_skip_verify": {
              "label": "跳過 TLS 憑證檢查"
            },
            "read_only": {
              "label": "唯讀模式",
              "description": "拒絕所有寫入操作（建立/刪除/修改/發送訊息）"
            },
            "page_size": {
              "label": "每頁數量"
            }
          }
        },
        "io.dbx.rocketmq-dashboard-console.workbench": {
          "label": "RocketMQ 控制台"
        }
      }
    }
  }
}
